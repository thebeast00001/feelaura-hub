# Copy to .env.local and fill in.

# --- Stripe (payments) ---------------------------------------------
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Clerk (authentication) ----------------------------------------
# Create a free app at https://dashboard.clerk.com and copy both keys.
# The site runs fine without them — auth UI simply stays hidden.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Z3Jvd24tYW5lbW9uZS01LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_AUNiGudq9wry87QqjeIiBt4yuf3jieGgECjIBbyq96
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (database: orders, newsletter) -----------------------
# Create a free project at https://supabase.com, run supabase-schema.sql
# in the SQL editor, then copy from Project Settings → API:
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
