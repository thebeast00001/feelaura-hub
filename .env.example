# Copy to .env.local and fill in.

# --- Stripe (payments) ---------------------------------------------
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Clerk (authentication) ----------------------------------------
# Create a free app at https://dashboard.clerk.com and copy both keys.
# The site runs fine without them — auth UI simply stays hidden.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (database: orders, newsletter) -----------------------
# Create a free project at https://supabase.com, run supabase-schema.sql
# in the SQL editor, then copy from Project Settings → API:
#   Project URL           -> NEXT_PUBLIC_SUPABASE_URL
#   service_role secret   -> SUPABASE_SERVICE_ROLE_KEY  (server-only, never expose)
# Row-Level Security is on with no public policies, so only the server
# (using the service_role key) can read or write. Leave blank to skip DB.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=